{
  "mcpServers": {
    "sdd-dashboard": {
      "command": "bun",
      "args": [
        "-e",
        "const a=process.argv[1]||'';const root=a&&!a.includes('CLAUDE_PLUGIN_ROOT')?a:(process.env.CLAUDE_PROJECT_DIR||process.cwd());const p=Bun.spawn([process.execPath,'run','--silent','start'],{cwd:require('path').join(root,'server'),stdio:['inherit','inherit','inherit']});for(const s of ['SIGINT','SIGTERM'])process.on(s,()=>p.kill(s));process.exit(await p.exited)",
        "${CLAUDE_PLUGIN_ROOT}"
      ]
    }
  }
}
